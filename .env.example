# Copy to .env. docker compose and `make run` (via your shell) read these.

LISTEN_ADDR=:8080
BASE_PATH=/piishield             # app is served only under this prefix; "/" serves at root
CLUSTER_NAME=nkp-sg-primary
CLUSTER_DISPLAY_NAME=Primary cluster
CLUSTER_ROLE=primary            # primary | standby
# BANNER_COLOR=blue             # default: blue for primary, orange for standby
# POD_NAME / NODE_NAME / POD_NAMESPACE are set by the Downward API in Kubernetes

# Nutanix Objects (S3). Leave S3_ENDPOINT empty for an in-memory store (local only).
S3_ENDPOINT=10.8.18.10
S3_USE_TLS=true
S3_INSECURE_SKIP_VERIFY=false
S3_BUCKET=secure-intake
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Fallback NAI config, used until settings are saved from the UI (stored in the bucket).
NAI_BASE_URL=https://nai.example.local/api/v1
NAI_API_KEY=
NAI_MODEL=
NAI_TIMEOUT=60s
NAI_INSECURE_SKIP_VERIFY=false

ADMIN_TOKEN=                    # if set, saving NAI settings asks for this token
MAX_UPLOAD_MB=8
SEED_SAMPLE_RECORDS=true        # write 3 fake records when the bucket is empty

# Demo-only values for the NKP cluster tile (no Kubernetes API calls are made)
DEMO_NODES=3
DEMO_PODS=2
DEMO_HPA_MAX=8
